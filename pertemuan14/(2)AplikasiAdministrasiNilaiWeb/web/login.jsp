<!DOCTYPE html>
<html>

<head>

<title>Login</title>

<link rel="stylesheet" href="style.css">

</head>

<body>

<div class="login-container">

<div class="login-box">

<h1>LOGIN ADMIN</h1>

<form action="LoginController" method="post">

<input type="text"
name="username"
placeholder="Masukkan Username"
required>

<br><br>

<input type="password"
name="password"
placeholder="Masukkan Password"
required>

<br><br>

<input type="submit" value="LOGIN">

</form>

</div>

</div>

</body>

</html>